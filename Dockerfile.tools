# Image "outils" : mêmes dépendances/sources que le stage `build` du Dockerfile principal,
# mais sans l'étape `npm run build` (inutile pour db:seed/db:unseed, qui tournent via tsx
# directement sur le source). Utilisée par le Job de seed OpenShift (voir openshift/seed-job.yaml)
# et peut aussi servir localement : docker build -f Dockerfile.tools -t imputo:tools .
FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
CMD ["true"]
