{
	"name": "imputo",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx src/lib/server/db/seed.ts",
		"db:unseed": "tsx src/lib/server/db/unseed.ts",
		"db:reset": "docker exec imputo-db psql -U imputo -d imputo -c 'drop schema public cascade; drop schema if exists drizzle cascade; create schema public;' && npm run db:migrate && npm run db:seed",
		"db:pull:prod": "./scripts/db-pull.sh prod",
		"db:pull:preprod": "./scripts/db-pull.sh preprod",
		"jira:sync": "tsx scripts/jira-sync.ts",
		"test": "WRAPPED_FORCE_OPEN= vitest run",
		"test:watch": "WRAPPED_FORCE_OPEN= vitest",
		"test:e2e": "cypress run",
		"test:e2e:open": "cypress open"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/adapter-vercel": "^5.10.2",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.0.1",
		"@types/web-push": "^3.6.4",
		"cypress": "^15.20.0",
		"drizzle-kit": "^0.31.5",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"driver.js": "^1.8.0",
		"drizzle-orm": "^0.45.2",
		"exceljs": "^4.4.0",
		"gsap": "^3.15.0",
		"pino": "^10.3.1",
		"pino-loki": "^3.0.0",
		"postgres": "^3.4.7",
		"svelte-confetti": "^2.3.2",
		"svelte-sonner": "^1.2.1",
		"web-push": "^3.6.7",
		"zod": "^4.1.12"
	},
	"overrides": {
		"uuid": "^11.1.1"
	}
}
