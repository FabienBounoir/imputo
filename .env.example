# --- Base de données ---
DATABASE_URL=postgres://imputo:imputo@localhost:5432/imputo

# --- Sécurité ---
SESSION_SECRET=change-me-in-production-please

# --- Politique d'inscription (création d'espace) ---
# Accepter les emails grand public (gmail, outlook, yahoo…) à l'auto-inscription.
ALLOW_PUBLIC_EMAIL_DOMAINS=false
# Whitelist stricte des domaines autorisés à créer un espace (CSV). Vide = tous (sous réserve du booléen ci-dessus).
ALLOWED_SIGNUP_DOMAINS=

# --- Durées ---
MAGIC_LINK_TTL=7d
ARCHIVE_RETENTION=30d

# --- Divers ---
PUBLIC_BASE_URL=http://localhost:5173
CRON_SECRET=change-me-cron-secret

# --- Build ---
# node (Docker/K8s) | vercel
BUILD_ADAPTER=node
