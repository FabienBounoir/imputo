# --- Base de données ---
DATABASE_URL=postgres://imputo:imputo@localhost:5432/imputo

# --- Sécurité ---
SESSION_SECRET=change-me-in-production-please

# --- Durées ---
MAGIC_LINK_TTL=7d
ARCHIVE_RETENTION=30d

# --- Divers ---
# Sert à construire les liens absolus envoyés (invitation membre, magic link) — en déploiement
# Docker/VPS, doit être la même URL publique que ORIGIN ci-dessous, sinon les liens générés
# pointent vers localhost. En dev (npm run dev), laisser le port Vite (5173).
BASE_URL=http://localhost:5173
CRON_SECRET=change-me-cron-secret

# Origine publique réelle en déploiement Docker/adapter-node (protocole + domaine/IP + port
# si non standard, ex. https://imputo.mondomaine.fr ou http://12.34.56.78:3000) — sans ça,
# tous les POST (formulaires, login…) sont rejetés en "Cross-site POST form submissions are
# forbidden" dès qu'on n'accède plus via localhost. Inutile en dev (npm run dev) ni sur Vercel.
# → doit avoir la même valeur que BASE_URL en déploiement Docker/VPS.
ORIGIN=http://localhost:3000

# --- Build ---
# node (Docker/K8s) | vercel
BUILD_ADAPTER=node

# --- Jira (synchronisation des tickets, pull planifié + forçage manuel) ---
# App registration Azure AD (client_credentials, credentials globales — le PAT Jira lui-même est
# saisi par espace dans l'UI admin, chiffré en base, jamais ici).
AZURE_TENANT_ID=8b87af7d-8647-4dc7-8df4-5f69a2011bb5
AZURE_CLIENT_ID=change-me-azure-client-id
AZURE_CLIENT_SECRET=change-me-azure-client-secret
JIRA_BASE_URL=https://jira.constellation.soprasteria.com
# 32 octets aléatoires en base64 (openssl rand -base64 32) — sert à chiffrer les PAT Jira en base.
# Distincte de SESSION_SECRET ; toute rotation rend les PAT déjà enregistrés indéchiffrables.
JIRA_PAT_ENCRYPTION_KEY=change-me-32-bytes-base64
