# --- Base de données ---
DATABASE_URL=postgres://imputo:imputo@localhost:5432/imputo

# --- Sécurité ---
SESSION_SECRET=change-me-in-production-please

# --- Durées ---
MAGIC_LINK_TTL=7d
ARCHIVE_RETENTION=30d

# --- Divers ---
PUBLIC_BASE_URL=http://localhost:5173
CRON_SECRET=change-me-cron-secret

# Origine publique réelle en déploiement Docker/adapter-node (protocole + domaine/IP + port
# si non standard, ex. https://imputo.mondomaine.fr ou http://12.34.56.78:3000) — sans ça,
# tous les POST (formulaires, login…) sont rejetés en "Cross-site POST form submissions are
# forbidden" dès qu'on n'accède plus via localhost. Inutile en dev (npm run dev) ni sur Vercel.
ORIGIN=http://localhost:3000

# --- Build ---
# node (Docker/K8s) | vercel
BUILD_ADAPTER=node
